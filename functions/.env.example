# Variabel environment untuk Firebase Cloud Functions
# Salin file ini ke .env dan isi nilainya

# Token dari @BotFather di Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Family ID dari Firestore kamu
# Cek di Firestore Console: collection 'families' → salin ID dokumennya
FAMILY_ID=your_family_id_here

# ID dan nama Wallet utama untuk menerima pemasukan (gaji)
# Cek di Firestore Console: families/{id}/wallets → salin ID dan name
MAIN_WALLET_ID=your_main_wallet_id_here
MAIN_WALLET_NAME=Nama Wallet Utama
